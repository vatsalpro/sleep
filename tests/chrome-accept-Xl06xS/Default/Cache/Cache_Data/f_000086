  function parseSpokenDate(text, outputType = 'date', nowDate = null) {
    const rawClean = String(text || '')
      .replace(/[०-९]/g, (d) => DEVANAGARI_DIGITS[d] || d)
      .replace(/,/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
