            nextRecommendedAction: 'Say "What about the second one?" or "Compare their admission requirements"'
          }
        };
      }

      if (/\b(?:laptop|laptops|notebook)\b/i.test(qLower)) {
        const items = [
          {
            index: 1,
            title: 'Lenovo ThinkPad X1 Carbon',
            officialUrl: 'https://www.lenovo.com/',
            url: 'https://www.lenovo.com/',
            summary: 'Lightweight business ultrabook series. Verify current generation CPU specs and live pricing on Lenovo’s official store.',
            entityType: 'product'
          },
          {
            index: 2,
            title: 'Apple MacBook Air',
            officialUrl: 'https://www.apple.com/macbook-air/',
            url: 'https://www.apple.com/macbook-air/',
            summary: 'Fanless ultrabook powered by Apple Silicon. Verify configuration options and regional pricing on Apple’s official store.',
            entityType: 'product'
          },
          {
            index: 3,
            title: 'Dell XPS Series',
            officialUrl: 'https://www.dell.com/',
            url: 'https://www.dell.com/',
            summary: 'Compact Windows ultrabook line. Check official Dell listings for exact display and battery specifications.',
            entityType: 'product'
          }
        ];
        const summaryEn =
          `Popular Ultrabook Categories (check official manufacturer sites for live prices and stock):\n` +
          `1. ${items[0].title}\n2. ${items[1].title}\n3. ${items[2].title}\n` +
          `You can say "Compare the second one with the first one." or "Open its official website."`;
        return {
          targetTopic: 'Laptops comparison',
          listItems: items,
          recommendedUrls: items.map((i) => ({ title: `${i.title} Official Site`, url: i.officialUrl, kind: 'product', official: true })),
          summaryEn,
          taskPatch: {
            objective: 'Comparing laptops',
            topic: 'Laptops',
            entities: items.map((i) => i.title),
            currentStep: 'listed_laptops',
