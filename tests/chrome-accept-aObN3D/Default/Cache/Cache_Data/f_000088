  const LABIAL_DEVANAGARI_RE = /^[पफबभम\u095E]/;

  const DEVANAGARI_CONJUNCTS = [
    ['क्ष', 'ksh'],
    ['त्र', 'tr'],
    ['ज्ञ', 'gy'],
    ['क़', 'k'],
    ['\u0958', 'k'],
    ['ख़', 'kh'],
    ['\u0959', 'kh'],
    ['ग़', 'g'],
    ['\u095A', 'g'],
    ['ज़', 'j'],
    ['\u095B', 'j'],
    ['फ़', 'f'],
    ['\u095E', 'f'],
    ['ड़', 'r'],
    ['\u095C', 'r'],
    ['ढ़', 'rh'],
    ['\u095D', 'rh'],
    ['य़', 'y'],
    ['\u095F', 'y']
  ];

  const DEVANAGARI_CHARS = {
    'क': 'k', 'ख': 'kh', 'ग': 'g', 'घ': 'gh', 'ङ': 'n',
    'च': 'ch', 'छ': 'chh', 'ज': 'j', 'झ': 'jh', 'ञ': 'n',
    'ट': 't', 'ठ': 'th', 'ड': 'd', 'ढ': 'dh', 'ण': 'n',
    'त': 't', 'थ': 'th', 'द': 'd', 'ध': 'dh', 'न': 'n',
