        nluPlan ||
        (preCentral && this.memory && preCentral.category !== this.memory.CENTRAL_INTENTS.GENERAL_QUESTION) ||
        (resolvedContext && resolvedContext.resolvedListItem && resolvedContext.resolvedListItem.entityType)
      );

