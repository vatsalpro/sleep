/* Sleepwalker Siri-Style Translucent Voice UI Tokens & Orb Styles (Shadow DOM only) */

:host {
  --sw-gold: #e7b54a;
  --sw-gold-bright: #ffe69a;
  --sw-gold-soft: rgba(246, 203, 108, 0.36);
  --sw-violet: #9e87f5;
  --sw-violet-soft: rgba(158, 135, 245, 0.32);
  --sw-amber: #f59e0b;
  --sw-danger-gold: #dc5b48;
  --sw-glass: rgba(255, 250, 240, 0.82);
  --sw-orb-glass: rgba(34, 28, 46, 0.56);
  --sw-glass-border: rgba(255, 224, 152, 0.88);
  --sw-ink: #1b1714;
  --sw-ink-muted: #4b4238;
  --sw-orb-size: 78px;
  --sw-radius-card: 28px;
  --sw-dur-fast: 220ms;
  --sw-dur-breathe: 4000ms;
  --sw-font: system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans Devanagari", "Kohinoor Devanagari", sans-serif;
  position: fixed;
  inset: 0;
  width: 0;
  height: 0;
  overflow: visible;
  pointer-events: none;
  z-index: 2147483644;
}

.sw-svg {
  width: 20px;
  height: 20px;
  min-width: 20px;
  min-height: 20px;
  max-width: 20px;
  max-height: 20px;
  display: inline-block;
  flex-shrink: 0;
  overflow: hidden;
}

svg {
  flex-shrink: 0;
}

.sw-ui-root,
.sw-ui-root * {
  box-sizing: border-box;
  font-family: var(--sw-font);
}

/* Full-screen passive stage: clicks, scrolling & typing ALWAYS pass through to the website */
.sw-ui-root {
  position: fixed;
  inset: 0;
  z-index: 2147483644;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 20px 16px 26px;
  opacity: 0;
  visibility: hidden;
  transition: none;
}

.sw-ui-root.sw-dissolving {
  opacity: 1;
  visibility: visible;
  transition: opacity var(--sw-dur-fast) ease, visibility var(--sw-dur-fast) ease;
}

/* Light veil (max 10% edge tint; center stays completely crisp) + threads canvas */
.sw-ui-veil {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background: radial-gradient(circle at 50% 42%, rgba(18, 15, 26, 0.03) 0%, rgba(18, 15, 26, 0.09) 100%);
  opacity: 0;
  transition: opacity 260ms ease;
}
.sw-ui-root[data-active="true"] .sw-ui-veil { opacity: 1; }
.sw-ui-root.sw-dissolving .sw-ui-veil,
.sw-ui-root.sw-dissolving .sw-orb-wrap,
.sw-ui-root.sw-dissolving .sw-transcript-chip { opacity: 0; transform: scale(0.88); }
.sw-ui-root.sw-dissolving .sw-card { opacity: 0; transform: translateX(-50%) scale(0.94); }
.sw-ui-root.sw-dissolving .sw-card.sw-pos-left,
.sw-ui-root.sw-dissolving .sw-card.sw-pos-right { transform: scale(0.94); }

.sw-threads-canvas {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
}

/* Idle stops every animation & transition cleanly */
.sw-ui-root[data-state="idle"]:not(.sw-dissolving),
.sw-ui-root[data-state="idle"]:not(.sw-dissolving) * {
  animation: none !important;
  transition: none !important;
  will-change: auto !important;
}

.sw-ui-root[data-active="true"] {
  opacity: 1;
  visibility: visible;
  transition: opacity var(--sw-dur-fast) ease, visibility var(--sw-dur-fast) ease;
}

.sw-orb-dock {
  position: relative;
  z-index: 6;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  pointer-events: none;
}

/* Faint live transcript chip above the orb */
.sw-transcript-chip {
  pointer-events: none;
  max-width: min(480px, 86vw);
  padding: 6px 14px;
  border-radius: 999px;
  background: rgba(255, 250, 240, 0.84);
  -webkit-backdrop-filter: blur(14px) saturate(1.3);
  backdrop-filter: blur(14px) saturate(1.3);
  border: 1px solid rgba(231, 181, 74, 0.55);
  box-shadow: 0 6px 20px rgba(24, 18, 12, 0.14);
  color: var(--sw-ink);
  font-size: 16px;
  line-height: 1.35;
  font-weight: 500;
  text-align: center;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity var(--sw-dur-fast) ease, transform var(--sw-dur-fast) ease;
}

.sw-transcript-chip[data-visible="true"] {
  opacity: 1;
  transform: translateY(0);
}

/* Inline 1-line typed fallback (only opens when user taps "Type") */
.sw-type-form {
  pointer-events: auto;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 8px 6px 14px;
  min-height: 48px;
  width: min(360px, 88vw);
  border-radius: 999px;
  background: rgba(255, 250, 240, 0.92);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  border: 1.5px solid var(--sw-gold-bright);
  box-shadow: 0 8px 24px rgba(32, 24, 14, 0.18), 0 0 18px var(--sw-gold-soft);
}

.sw-type-form[hidden] {
  display: none;
}

.sw-type-input {
  flex: 1;
  min-width: 0;
  border: none;
  background: transparent;
  color: var(--sw-ink);
  font-size: 16px;
  outline: none;
}

.sw-type-submit {
  pointer-events: auto;
  min-width: 48px;
  min-height: 36px;
  padding: 6px 14px;
  border: none;
  border-radius: 999px;
  background: linear-gradient(135deg, #f3c65f, #d99b26);
  color: #1b1407;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
}

.sw-orb-row { position: relative; display: flex; align-items: center; justify-content: center; pointer-events: none; }
.sw-orb-wrap { position: relative; width: var(--sw-orb-size); height: var(--sw-orb-size); display: flex; align-items: center; justify-content: center; pointer-events: auto; transform: scale(0.84); opacity: 0; }
.sw-ui-root[data-active="true"] .sw-orb-wrap, .sw-ui-root.sw-dissolving .sw-orb-wrap { transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1), opacity 220ms ease; }
.sw-ui-root[data-active="true"] .sw-orb-wrap { transform: scale(1); opacity: 1; will-change: transform, opacity; }
.sw-orb-halo { position: absolute; inset: -14px; border-radius: 50%; background: radial-gradient(circle, var(--sw-gold-soft) 0%, var(--sw-violet-soft) 52%, transparent 72%); pointer-events: none; opacity: 0.72; transform: scale(1); }
.sw-orb-btn {
  position: relative; width: var(--sw-orb-size); height: var(--sw-orb-size); border-radius: 50%; border: 2px solid var(--sw-glass-border);
  background: radial-gradient(circle at 32% 28%, rgba(255, 250, 232, 0.52), rgba(145, 118, 224, 0.24) 54%, rgba(30, 22, 42, 0.72) 100%);
  -webkit-backdrop-filter: blur(18px) saturate(1.4); backdrop-filter: blur(18px) saturate(1.4);
  box-shadow: inset 0 2px 10px rgba(255, 248, 220, 0.55), inset 0 -8px 16px rgba(158, 135, 245, 0.35), 0 10px 28px rgba(20, 14, 34, 0.28), 0 0 22px var(--sw-gold-soft);
  display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; outline: none;
}
.sw-orb-btn:focus-visible, .sw-type-btn:focus-visible, .sw-type-submit:focus-visible, .sw-card button:focus-visible { outline: 3px solid #2563eb; outline-offset: 2px; }
.sw-orb-bars { display: flex; align-items: center; justify-content: center; gap: 3.5px; height: 36px; pointer-events: none; }
.sw-bar { width: 3px; height: 32px; border-radius: 999px; background: linear-gradient(180deg, #fff8dc 0%, #f5cb66 55%, #fff0bd 100%); transform-origin: center; transform: scaleY(var(--bar-scale, 0.24)); transition: transform 90ms ease-out; }
.sw-type-btn {
  position: absolute; left: calc(100% + 12px); top: 50%; transform: translateY(-50%); pointer-events: auto; min-width: 48px; min-height: 48px;
  padding: 0 14px; border-radius: 999px; border: 1px solid rgba(231, 181, 74, 0.55); background: rgba(255, 250, 240, 0.84);
  -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); color: var(--sw-ink); font-size: 14px; font-weight: 600; cursor: pointer;
  box-shadow: 0 4px 14px rgba(24, 18, 12, 0.14);
}
/* Floating warm-white frosted glass Response Card (matches mockup) */
.sw-card {
  position: fixed; left: 50%; bottom: var(--sw-dock-clearance, calc(var(--sw-orb-size) + 54px)); transform: translateX(-50%); z-index: 4;
  width: min(560px, calc(100vw - 32px)); max-height: calc(100vh - var(--sw-dock-clearance, 136px) - 20px); padding: 18px 20px 16px;
  display: flex; flex-direction: column; gap: 10px; pointer-events: auto; border-radius: var(--sw-radius-card); overflow: hidden;
  background: rgba(255, 250, 240, 0.88); -webkit-backdrop-filter: blur(20px) saturate(1.25); backdrop-filter: blur(20px) saturate(1.25);
  border: 1.5px solid var(--sw-glass-border); color: var(--sw-ink);
  box-shadow: 0 16px 40px rgba(24, 18, 12, 0.2), 0 0 26px var(--sw-gold-soft);
  transition: transform 220ms ease, opacity 220ms ease, bottom 160ms ease;
}
.sw-card[hidden] { display: none; }
.sw-card[data-card-type="error"] { border-color: rgba(220, 91, 72, 0.85); }
.sw-card.sw-pos-top { bottom: auto; top: 16px; max-height: calc(100vh - var(--sw-dock-clearance, 136px) - 24px); }
.sw-card.sw-pos-left { left: 18px; transform: none; }
.sw-card.sw-pos-right { left: auto; right: 18px; transform: none; }
.sw-card-tail {
  position: absolute; left: 50%; bottom: -9px; width: 16px; height: 16px; transform: translateX(-50%) rotate(45deg);
  background: rgba(255, 250, 240, 0.9); border-right: 1.5px solid var(--sw-glass-border); border-bottom: 1.5px solid var(--sw-glass-border);
  pointer-events: none;
}
.sw-card-tail[hidden] { display: none; }
.sw-card-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.sw-card-title-row { display: flex; align-items: center; gap: 8px; min-width: 0; }
.sw-sparkle {
  width: 28px; height: 28px; border-radius: 50%; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #f3c65f, #d99b26); color: #fff; box-shadow: 0 2px 8px var(--sw-gold-soft); overflow: hidden;
}
.sw-sparkle .sw-svg,
.sw-sparkle svg {
  width: 16px; height: 16px; min-width: 16px; min-height: 16px; max-width: 16px; max-height: 16px; display: inline-block; flex-shrink: 0; overflow: hidden;
}
.sw-card-title { margin: 0; font-size: 19px; font-weight: 700; color: var(--sw-ink); line-height: 1.25; }
.sw-card-badge { font-size: 13px; font-weight: 700; padding: 3px 9px; border-radius: 999px; background: rgba(231, 181, 74, 0.25); color: var(--sw-ink); }
.sw-card-tools { display: flex; align-items: center; gap: 4px; flex: 0 0 auto; }
.sw-tool-btn { min-width: 48px; min-height: 48px; border-radius: 999px; border: 1px solid transparent; background: transparent; color: var(--sw-ink); font-size: 14px; font-weight: 600; cursor: pointer; }
.sw-tool-btn:hover, .sw-tool-active { background: rgba(231, 181, 74, 0.28); border-color: rgba(217, 155, 38, 0.65); }
.sw-card-menu { padding: 8px 10px; border-radius: 16px; background: rgba(255, 253, 247, 0.96); border: 1px solid rgba(231, 181, 74, 0.55); display: flex; flex-direction: column; gap: 6px; }
.sw-card-menu[hidden] { display: none; }
.sw-menu-row { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; font-size: 13px; font-weight: 700; color: var(--sw-ink-muted); }
.sw-menu-row button { min-width: 48px; min-height: 36px; padding: 4px 10px; border-radius: 999px; border: 1px solid rgba(27, 23, 20, 0.16); background: #fff; color: var(--sw-ink); font-size: 13px; font-weight: 600; cursor: pointer; }
.sw-card-body { flex: 1 1 auto; min-height: 0; max-height: 45vh; overflow-y: auto; font-size: var(--sw-card-font, 18px); line-height: 1.5; color: var(--sw-ink); }
.sw-card.sw-expanded .sw-card-body { max-height: none; }
@media (max-height: 620px), (max-width: 520px) {
  .sw-ui-root { padding: 12px 10px 16px; }
  .sw-card { width: calc(100vw - 20px); padding: 14px 14px 12px; gap: 8px; }
  .sw-card-body { max-height: 38vh; font-size: 16px; }
  .sw-type-form { width: min(340px, 88vw); min-height: 44px; }
}
.sw-card-p, .sw-topic-text { margin: 0 0 8px; }
.sw-topic { padding: 6px 8px; border-radius: 12px; transition: opacity 200ms ease; }
.sw-topic[hidden] { display: none; }
.sw-topic-past { opacity: 0.52; }
.sw-topic-active { background: rgba(246, 203, 108, 0.18); }
.sw-topic-title { font-weight: 700; font-size: 17px; margin-bottom: 2px; color: var(--sw-ink); }
.sw-sentence-active { background: rgba(246, 203, 108, 0.48); border-radius: 4px; padding: 0 2px; }
.sw-card-meta, .sw-card-readback, .sw-card-file-info { font-size: 16px; font-weight: 600; margin-bottom: 6px; color: var(--sw-ink); }
.sw-card-media { display: block; width: 100%; max-height: 200px; object-fit: cover; border-radius: 14px; margin: 4px 0 8px; border: 1px solid rgba(231, 181, 74, 0.55); }
.sw-confirm-summary { margin: 6px 0 8px; padding-left: 20px; font-size: 16px; }
.sw-choice-list, .sw-plan-list { display: flex; flex-direction: column; gap: 8px; margin: 6px 0 0; padding: 0; list-style: none; }
.sw-plan-compact { gap: 4px; margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(27, 23, 20, 0.12); font-size: 14px; color: var(--sw-ink-muted); }
.sw-plan-step-done { opacity: 0.78; }
.sw-plan-step-active { font-weight: 700; color: var(--sw-ink); }
.sw-plan-step-failed { color: #b91c1c; font-weight: 600; }
.sw-choice-btn { width: 100%; min-height: 48px; padding: 10px 14px; text-align: left; border-radius: 14px; border: 1px solid rgba(217, 155, 38, 0.55); background: rgba(255, 255, 255, 0.85); color: var(--sw-ink); font-size: 17px; font-weight: 600; cursor: pointer; }
.sw-card-controls, .sw-card-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.sw-card-controls[hidden], .sw-card-actions[hidden] { display: none; }
.sw-ctrl-btn { min-height: 48px; padding: 8px 14px; border-radius: 999px; border: 1px solid rgba(27, 23, 20, 0.18); background: rgba(255, 255, 255, 0.82); color: var(--sw-ink); font-size: 15px; font-weight: 600; cursor: pointer; }
.sw-act-btn { flex: 1 1 auto; min-width: 96px; min-height: 48px; padding: 10px 16px; border-radius: 999px; border: 1.5px solid rgba(27, 23, 20, 0.22); background: rgba(255, 255, 255, 0.9); color: var(--sw-ink); font-size: 16px; font-weight: 700; cursor: pointer; }
.sw-act-primary { background: linear-gradient(135deg, #f3c65f, #d99b26); border-color: #b47812; color: #1b1407; }

@keyframes sw-breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.04); } }
@keyframes sw-halo-pulse { 0%, 100% { transform: scale(0.96); opacity: 0.65; } 50% { transform: scale(1.1); opacity: 0.95; } }
@keyframes sw-confirm-pulse { 0%, 100% { transform: scale(1); opacity: 0.75; } 50% { transform: scale(1.07); opacity: 1; } }
@keyframes sw-error-pulse { 0% { transform: scale(1); opacity: 0.9; } 45% { transform: scale(1.1); opacity: 1; } 100% { transform: scale(1); opacity: 0.72; } }

.sw-ui-root[data-state="silent"] .sw-orb-wrap { animation: sw-breathe var(--sw-dur-breathe) ease-in-out infinite; }
.sw-ui-root[data-state="listening"] .sw-orb-halo,
.sw-ui-root[data-state="thinking"] .sw-orb-halo,
.sw-ui-root[data-state="speaking"] .sw-orb-halo { animation: sw-halo-pulse 1.5s ease-in-out infinite; }
.sw-ui-root[data-state="confirm"] .sw-orb-halo {
  background: radial-gradient(circle, rgba(245, 158, 11, 0.56) 0%, var(--sw-gold-soft) 55%, transparent 74%);
  animation: sw-confirm-pulse 2.2s ease-in-out infinite;
}
.sw-ui-root[data-state="error"] .sw-orb-halo {
  background: radial-gradient(circle, rgba(220, 91, 72, 0.58) 0%, var(--sw-gold-soft) 55%, transparent 74%);
  animation: sw-error-pulse 750ms ease-out 1;
}
@media (prefers-reduced-motion: reduce) {
  .sw-ui-root, .sw-ui-root * { animation: none !important; transition-duration: 120ms !important; }
}

/* Phase 5 Presentation Extensions inside existing Warm Frosted Glass Card */
.sw-table-wrap { margin: 8px 0; overflow-x: auto; border-radius: 14px; border: 1px solid rgba(217, 155, 38, 0.42); background: rgba(255, 255, 255, 0.78); }
.sw-table { width: 100%; border-collapse: collapse; font-size: 14px; line-height: 1.4; text-align: left; }
.sw-table th, .sw-table td { padding: 7px 10px; border-bottom: 1px solid rgba(27, 23, 20, 0.09); vertical-align: top; }
.sw-table th { background: rgba(231, 181, 74, 0.22); font-weight: 700; color: var(--sw-ink); }
.sw-table tr:last-child td { border-bottom: none; }
.sw-numbered-list { margin: 6px 0 8px; padding-left: 22px; display: flex; flex-direction: column; gap: 5px; font-size: 16px; }
.sw-card-warning { margin: 6px 0; padding: 8px 12px; border-radius: 12px; border: 1px solid rgba(245, 158, 11, 0.55); background: rgba(254, 243, 199, 0.85); color: #78350f; font-size: 14px; font-weight: 600; }
.sw-card-sources { margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(27, 23, 20, 0.1); font-size: 13px; color: var(--sw-ink-muted); display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; }
.sw-source-link { color: #92400e; text-decoration: underline; font-weight: 600; cursor: pointer; background: none; border: none; padding: 0; font-size: 13px; }
.sw-proactive-bar {
  margin-top: 6px; padding: 9px 12px; border-radius: 16px;
  border: 1px solid rgba(231, 181, 74, 0.65); background: rgba(255, 248, 226, 0.9);
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px;
}
.sw-proactive-text { font-size: 14px; font-weight: 600; color: var(--sw-ink); flex: 1 1 220px; line-height: 1.35; }
.sw-proactive-btns { display: flex; gap: 6px; flex: 0 0 auto; }
.sw-proactive-btn { min-height: 36px; padding: 5px 12px; border-radius: 999px; border: 1px solid rgba(27, 23, 20, 0.2); background: #fff; color: var(--sw-ink); font-size: 13px; font-weight: 700; cursor: pointer; }
.sw-proactive-btn.sw-proactive-go { background: linear-gradient(135deg, #f3c65f, #d99b26); border-color: #b47812; color: #1b1407; }
