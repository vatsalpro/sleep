# Sleepwalker 2.0 Environment Configuration
# Copy this file to .env and configure your keys/endpoints (.env is gitignored)

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Local Ollama AI Services
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_FAST_MODEL=qwen2.5:1.5b
OLLAMA_PLAN_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_VISION_MODEL=qwen3-vl:2b

# Bridge & Runtime Configuration
BRIDGE_PORT=4888
LOCAL_ONLY=false
